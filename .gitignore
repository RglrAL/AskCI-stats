# macOS
.DS_Store

# QA feed exports hold citizens' questions — never commit them
qa-feed*.csv

# Built droplet app (rebuild with: osacompile -o "tools/AskCI Feed Export.app" tools/feed_droplet.applescript)
*.app/

# Review folders written by the feed droplet
askci-export-*/
__pycache__/

# npm packages for tools/test_ask_node.js (npm install jsdom@24 papaparse@5.4.1)
node_modules/
package-lock.json

# The independent review report (PDF) is kept local: it names people and discusses figures sent to a department
ask review/

# Everything under exports/ is per-turn or holds feed text (review folders, labelling sheets): never commit it
exports/
reports/
